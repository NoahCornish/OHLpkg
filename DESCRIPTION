Package: OHLpkg
Type: Package
Title: Ontario Hockey League Statistics Tools
Version: 2.6.0
Date: 2026-09-21
Authors@R:
    person(
        given = "Noah",
        family = "Cornish",
        role = c("aut", "cre"),
        email = "noahcornish7@gmail.com"
